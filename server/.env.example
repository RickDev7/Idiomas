# Chave do Gemini — NUNCA commite este arquivo com uma chave real.
GEMINI_API_KEY=

# Opcional: modelo Live (padrão: gemini-3.1-flash-live-preview)
GEMINI_MODEL=gemini-3.1-flash-live-preview

# Modelo de texto (tradução / explicação). gemini-2.5-flash foi descontinuado.
GEMINI_TEXT_MODEL=gemini-3.6-flash

# Opcional: porta do backend (padrão: 8787)
PORT=8787
